rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read:  if request.auth.uid == uid;
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null;

      allow update: if request.auth != null;

      // Command Centre can update status and governance fields.
      allow update: if request.auth.token.role == "commandcenter"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updated_at", "resolved_at",
          "department_status", "department_progress",
          "governance"
        ]);

      // H1 Fix: Community confirmation.
      // - confirmation_count must increment by exactly 1 (prevents count=9999 attack).
      // - escalated=true only allowed when new count reaches the threshold of 3.
      allow update: if request.auth != null
        && request.auth.uid != resource.data.reporter_uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "confirmation_count", "escalated", "escalated_at", "escalation_reason", "updated_at"
        ])
        && request.resource.data.confirmation_count == resource.data.confirmation_count + 1
        && (
          !("escalated" in request.resource.data.diff(resource.data).affectedKeys())
          || !request.resource.data.escalated
          || request.resource.data.confirmation_count >= 3
        );

      // Comment count: separate rule, also enforces increment-by-1.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "comment_count", "updated_at"
        ])
        && request.resource.data.comment_count == resource.data.comment_count + 1;

      allow delete: if request.auth.token.role == "commandcenter";

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.user_uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      match /confirmations/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid != get(/databases/$(database)/documents/issues/$(issueId)).data.reporter_uid
          && !exists(/databases/$(database)/documents/issues/$(issueId)/confirmations/$(request.auth.uid));
      }

      match /case_events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false; // Immutable audit log
      }
    }
  }
}
