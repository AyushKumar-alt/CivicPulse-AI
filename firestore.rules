rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read:  if request.auth.uid == uid;
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if request.auth != null && (
        resource.data.reporter_uid == request.auth.uid
        || resource.data.status in ["analyzed", "in_progress", "resolved"]
        || request.auth.token.role in ["authority", "commandcenter"]
      );

      allow create: if request.auth != null
        && request.resource.data.reporter_uid == request.auth.uid;

      // Authority (department) can update status and department workflow fields
      allow update: if request.auth.token.role == "authority"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updated_at",
          "department_status", "department_progress",
          "action_plan", "action_plan_generated_at",
          "verification"
        ]);

      // Command Centre can update status, governance, and department workflow fields
      allow update: if request.auth.token.role == "commandcenter"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updated_at", "resolved_at",
          "department_status", "department_progress",
          "governance"
        ]);

      // Reporter can write AI analysis results (analysis runs client-side, result written here)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.reporter_uid
        && resource.data.status == "processing"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "ai", "status", "updated_at",
          "area_category", "area_confidence", "area_reasoning", "affected_entity_type",
          "assigned_department", "assigned_department_name", "assigned_department_email",
          "assigned_at", "assigned_by", "assignment_method", "location"
        ]);

      allow delete: if request.auth.token.role == "commandcenter";

      match /confirmations/{uid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid != get(/databases/$(database)/documents/issues/$(issueId)).data.reporter_uid
          && !exists(/databases/$(database)/documents/issues/$(issueId)/confirmations/$(request.auth.uid));

        allow update, delete: if false;
      }
    }
  }
}
